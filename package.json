{
  "name": "gobo",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "autostart": "node scripts/autostart.mjs",
    "package": "node scripts/package-connector.mjs",
    "winget": "node scripts/winget-manifest.mjs",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:bridge": "npm run dev --workspace=packages/bridge",
    "dev:ui": "npm run dev --workspace=packages/ui",
    "build": "npm run build --workspace=packages/ui",
    "preview": "npm run preview --workspace=packages/ui",
    "bridge:build": "npm run build --workspace=packages/bridge",
    "bridge:start": "npm run start --workspace=packages/bridge",
    "bridge:selftest": "node scripts/bridge-selftest.mjs",
    "desktop": "npm run desktop:build && electron packages/desktop",
    "desktop:build": "npm run build && npm run bridge:build && npm run build --workspace=packages/desktop",
    "desktop:package": "npm run desktop:build && electron-builder --projectDir packages/desktop",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/check-names.mjs && vitest run",
    "test:watch": "vitest",
    "check:names": "node scripts/check-names.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^2.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
